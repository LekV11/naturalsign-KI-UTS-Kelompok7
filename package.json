{
  "name": "naturalsign",
  "version": "1.0.0",
  "description": "Aplikasi Digital Signature PDF & Verifikasi QR-Code untuk UTS Keamanan Informasi Universitas Siliwangi",
  "type": "module",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "node --watch src/api/server.js",
    "test": "node --test tests/**/*.test.js",
    "benchmark": "node benchmark/benchmark.js",
    "generate-sample": "node sample-data/createSamplePdf.js"
  },
  "keywords": [
    "digital-signature",
    "pdf",
    "ecdsa",
    "sha256",
    "qr-code",
    "cryptography",
    "keamanan-informasi"
  ],
  "author": "Tim Proyek Keamanan Informasi - Universitas Siliwangi",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
