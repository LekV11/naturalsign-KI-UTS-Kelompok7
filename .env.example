# NaturalSign - Environment Configuration
PORT=3000
NODE_ENV=development

# Default App Metadata
APP_NAME=NaturalSign
APP_URL=http://localhost:3000

# Security Defaults
# Default algorithm: ECDSA_P256 (options: ECDSA_P256, RSA_PSS_2048)
CRYPTO_ALGORITHM=ECDSA_P256
HASH_ALGORITHM=sha256

# Keystore derivation rounds (PBKDF2)
KEYSTORE_KDF_ITERATIONS=100000
